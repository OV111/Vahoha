# Backend environment. Copy to backend/.env and fill in; never commit backend/.env.
# Generated from backend/config/env.js by backend/scripts/writeEnvExample.js: edit there.
# Optional variables are commented out; uncomment one to set it.

# ── core ──────────────────────────────────────────────────────────────────
# development, staging or production. Production turns on the stricter checks below. (optional; if unset: treated as development, so the production-only checks are skipped)
# NODE_ENV=development
# Port the API listens on. Render sets it for you. (optional; if unset: defaults to 5000)
# PORT=5000
# MongoDB connection string (Atlas: mongodb+srv://...). (required; if unset: the server refuses to start)
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/DevsBlog
# The Vercel URL, https, no trailing slash or path. Also the CORS origin and the sign-in redirect target. (required in production; if unset: falls back to http://localhost:5173, which breaks CORS and sign-in redirects in production)
FRONTEND_URL=https://vahoha.com

# ── auth ──────────────────────────────────────────────────────────────────
# Signs access tokens. The name has this exact casing. Use a long random string. (required; if unset: the server refuses to start)
JWT_Secret=change-me-to-a-long-random-string
# Signs refresh tokens. Must differ from JWT_Secret. (required; if unset: the server refuses to start)
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Google OAuth client id (also set VITE_GOOGLE_CLIENT_ID in the frontend). (optional; if unset: Google sign-in is off)
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# GitHub OAuth app client id. Use a separate app per environment (the callback URL differs). (optional; if unset: GitHub sign-in and the capstone GitHub link are off)
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GitHub OAuth app client secret. Set together with GITHUB_CLIENT_ID. (optional; if unset: GitHub sign-in is off)
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Fine-grained token with read-only access to public repos. Used by capstone checks and the Project Map repo scan. (optional; if unset: GitHub allows only 60 requests an hour, so scans and capstone checks hit the limit fast)
# GITHUB_TOKEN=github_pat_your-token

# ── ai ────────────────────────────────────────────────────────────────────
# Groq key for the mentor, teach-back, capstone review, repo scan labels and map questions. Use a paid tier for real use. (optional; if unset: every AI feature fails when it is first used)
# GROQ_API_KEY=gsk_your-groq-key
# Separate Groq key for voice exam speech-to-text (Whisper), so voice can't use up the mentor's quota. (optional; if unset: speech-to-text uses GROQ_API_KEY and shares its quota)
# GROQ_VOICE_API_KEY=gsk_your-voice-key
# Gemini key. Nothing imports config/gemini.js today, so it is unused. (optional; if unset: nothing (unused today))
# GEMINI_API_KEY=your-gemini-key
# Cap on repo code sent to the capstone AI review. (optional; if unset: uses the built-in default)
# CAPSTONE_REVIEW_MAX_CHARS=60000
# Tokens per minute your Groq tier allows for the key. All AI calls share it: a call waits for its tokens or fails with a 'busy' message instead of being refused by Groq. (optional; if unset: no token budget is enforced (only the concurrency cap and the pause after a Groq 429 apply))
# GROQ_GATE_TPM=250000
# Most Groq calls in flight at once, per server instance. A mentor stream counts until its last token. (optional; if unset: uses the built-in default (8))
# GROQ_GATE_CONCURRENCY=8
# Most voice-exam transcriptions (Whisper) in flight at once, per server instance. Separate from the chat gate. (optional; if unset: uses the built-in default (4))
# GROQ_WHISPER_CONCURRENCY=4

# ── email ─────────────────────────────────────────────────────────────────
# Resend key for password reset, magic-link sign-in and contact emails. vahoha.com must be verified in Resend. (optional; if unset: email sending is off, so reset and magic-link emails never arrive)
# RESEND_API_KEY=re_your-resend-key
# Sender address, e.g. "Vahoha <no-reply@vahoha.com>". Set together with RESEND_API_KEY. (optional; if unset: falls back to Resend's test sender, which only reaches the account owner)
# EMAIL_FROM="Vahoha <no-reply@vahoha.com>"
# Bearer token the weekly-summary GitHub workflow sends. Same value as the WEEKLY_SUMMARY_CRON_SECRET repository secret. (optional; if unset: the run endpoint refuses every call, so no weekly summary emails go out)
# WEEKLY_SUMMARY_CRON_SECRET=change-me-to-a-long-random-string
# This API's public origin, no trailing slash. Used for Gmail's one-click unsubscribe header in weekly emails. (optional; if unset: weekly emails go out without the one-click unsubscribe header (the link inside the email still works))
# API_PUBLIC_URL=https://api.vahoha.com
# Where contact-form messages are sent. (optional; if unset: uses the built-in inbox)
# CONTACT_INBOX=hello@vahoha.com

# ── uploads ───────────────────────────────────────────────────────────────
# Cloudinary cloud name (profile photos, blog images). Set all three Cloudinary variables or none. (optional; if unset: image uploads fail)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# Cloudinary API key. (optional; if unset: image uploads fail)
# CLOUDINARY_API_KEY=your-cloudinary-key
# Cloudinary API secret. (optional; if unset: image uploads fail)
# CLOUDINARY_API_SECRET=your-cloudinary-secret

# ── billing ───────────────────────────────────────────────────────────────
# Only the exact value "production" uses the real Polar; anything else is the sandbox, so a forgotten value can never charge a card. (optional; if unset: Polar sandbox)
# POLAR_ENVIRONMENT=sandbox
# Polar organisation access token. Required when BILLING_ENFORCED=true. (optional; if unset: checkout cannot be created)
# POLAR_ACCESS_TOKEN=polar_oat_your-token
# Id of the Pro product in Polar. Required when BILLING_ENFORCED=true. (optional; if unset: checkout cannot be created)
# POLAR_PRO_PRODUCT_ID=your-polar-product-id
# Signs Polar webhooks. Required when BILLING_ENFORCED=true. (optional; if unset: the webhook answers 503 on purpose)
# POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# true makes Pro gates real. Anything else keeps every feature free (the pilot setting). (optional; if unset: everything is free)
# BILLING_ENFORCED=false

# ── redis ─────────────────────────────────────────────────────────────────
# false runs without Redis: no notification queue and no Redis login throttling. Any other value (or unset) means on. (optional; if unset: Redis is on)
# REDIS_ENABLED=true
# Hosted Redis URL with host, port, password and TLS. Wins over the host/port variables. (optional; if unset: uses REDIS_HOST and REDIS_PORT, or localhost)
# REDIS_URL=rediss://default:password@host:6379
# Redis host for a local or Docker Redis (ignored when REDIS_URL is set). (optional; if unset: localhost)
# REDIS_HOST=localhost
# Redis port (ignored when REDIS_URL is set). (optional; if unset: 6379)
# REDIS_PORT=6379
# Redis password (ignored when REDIS_URL is set). (optional; if unset: no password)
# REDIS_PASSWORD=your-redis-password

# ── monitoring ────────────────────────────────────────────────────────────
# Sentry DSN of the vahoha-api project. Read by backend/instrument.js before the server starts. (optional; if unset: errors are only logged to the console, nothing is sent to Sentry)
# SENTRY_DSN=https://public-key@o0.ingest.de.sentry.io/0

# ── flags ─────────────────────────────────────────────────────────────────
# true opens the recruiter candidates list API. Leave it off until the page is switched on. (optional; if unset: the candidates API stays closed)
# CANDIDATES_ENABLED=false
# true opens the hiring sign-up API (recruiter accounts and the company trust engine). (optional; if unset: the hiring API answers 404)
# HIRING_ENABLED=false
# true makes every route answer 503 (/healthz stays up). The emergency stop. (optional; if unset: normal service)
# MAINTENANCE_MODE=false
# false turns the server-side cache off (to rule it out while debugging). Unset means on, except under tests. (optional; if unset: cache on)
# CACHE_ENABLED=true
# true lets the code runner execute learner code outside the isolated-vm sandbox when it did not build. NEVER in production. (optional; if unset: in production the runner refuses submissions when isolated-vm is missing)
# ALLOW_UNSAFE_RUNNER=false
# Extra browser origins allowed to open a WebSocket, comma separated (besides FRONTEND_URL). (optional; if unset: only FRONTEND_URL may connect)
# WS_EXTRA_ORIGINS=https://staging.vahoha.com

# ── runner ────────────────────────────────────────────────────────────────
# Base URL of the Judge0 server that runs submissions in languages other than JavaScript and TypeScript. (optional; if unset: only JavaScript and TypeScript challenges can be submitted)
# JUDGE0_URL=https://judge0.example.com
# Token sent to Judge0 as X-Auth-Token. Set it when your own Judge0 server requires one. (optional; if unset: requests to Judge0 carry no token)
# JUDGE0_AUTH_TOKEN=your-judge0-token

# ── local ─────────────────────────────────────────────────────────────────
# Local-only workaround for the Groq free tier's tokens-per-minute limit. Do NOT set it in production. (optional; if unset: no limit applied)
# GROQ_TPM_LIMIT=6000
# Model used by the mentor eval script only. (optional; if unset: uses the built-in model)
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b
# Comma-separated DNS servers, for networks that cannot resolve Atlas's mongodb+srv records. (optional; if unset: uses the system DNS)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Seed scripts only: 1 lets the capstone seeder publish briefs whose exam banks are missing. (optional; if unset: the seeder skips unbanked tracks)
# ALLOW_UNBANKED_PUBLISH=0
