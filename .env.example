# Vahoha configuration template. Placeholders only: NEVER commit real values.
#
# Backend variables go in backend/.env (or backend/.env.local, which wins). On Render
# they are set in the dashboard. They are checked once at boot (backend/config/env.js):
# a REQUIRED one that is missing stops the server and lists every problem together.
#
# Frontend (VITE_*) variables go in the root .env.development / .env.production files
# locally and in the project settings on Vercel. Only public values belong there.

# ── Core ────────────────────────────────────────────────────────────────

# development, staging or production. Production turns on the stricter checks below.
# Optional. If missing: treated as development, so the production-only checks are skipped.
# NODE_ENV=development

# Port the API listens on. Render sets it for you.
# Optional. If missing: defaults to 5000.
# PORT=5000

# MongoDB connection string (Atlas: mongodb+srv://...).
# REQUIRED. If missing: the server refuses to start.
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/DevsBlog

# The Vercel URL, https, no trailing slash or path. Also the CORS origin and the sign-in redirect target.
# REQUIRED in production, optional while developing. If missing: falls back to http://localhost:5173, which breaks CORS and sign-in redirects in production.
# FRONTEND_URL=https://vahoha.com

# ── Sign-in and GitHub ──────────────────────────────────────────────────

# Signs access tokens. The name has this exact casing. Use a long random string.
# REQUIRED. If missing: the server refuses to start.
JWT_Secret=change-me-to-a-long-random-string

# Signs refresh tokens. Must differ from JWT_Secret.
# REQUIRED. If missing: the server refuses to start.
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Google OAuth client id (also set VITE_GOOGLE_CLIENT_ID in the frontend).
# Optional. If missing: Google sign-in is off.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# GitHub OAuth app client id. Use a separate app per environment (the callback URL differs).
# Optional. If missing: GitHub sign-in and the capstone GitHub link are off.
# GITHUB_CLIENT_ID=your-github-oauth-client-id

# GitHub OAuth app client secret. Set together with GITHUB_CLIENT_ID.
# Optional. If missing: GitHub sign-in is off.
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Fine-grained token with read-only access to public repos. Used by capstone checks and the Project Map repo scan.
# Optional. If missing: GitHub allows only 60 requests an hour, so scans and capstone checks hit the limit fast.
# GITHUB_TOKEN=github_pat_your-token

# ── AI ──────────────────────────────────────────────────────────────────

# Groq key for the mentor, teach-back, capstone review, repo scan labels and map questions. Use a paid tier for real use.
# Optional. If missing: every AI feature fails when it is first used.
# GROQ_API_KEY=gsk_your-groq-key

# Gemini key. Nothing imports config/gemini.js today, so it is unused.
# Optional. If missing: nothing (unused today).
# GEMINI_API_KEY=your-gemini-key

# Cap on repo code sent to the capstone AI review.
# Optional. If missing: uses the built-in default.
# CAPSTONE_REVIEW_MAX_CHARS=60000

# Tokens per minute your Groq tier allows for the key. All AI calls share it: a call waits for its tokens or fails with a 'busy' message instead of being refused by Groq.
# Optional. If missing: no token budget is enforced (only the concurrency cap and the pause after a Groq 429 apply).
# GROQ_GATE_TPM=250000

# Most Groq calls in flight at once, per server instance. A mentor stream counts until its last token.
# Optional. If missing: uses the built-in default (8).
# GROQ_GATE_CONCURRENCY=8

# ── Email ───────────────────────────────────────────────────────────────

# Resend key for password reset, magic-link sign-in and contact emails. vahoha.com must be verified in Resend.
# Optional. If missing: email sending is off, so reset and magic-link emails never arrive.
# RESEND_API_KEY=re_your-resend-key

# Sender address, e.g. "Vahoha <no-reply@vahoha.com>". Set together with RESEND_API_KEY.
# Optional. If missing: falls back to Resend's test sender, which only reaches the account owner.
# EMAIL_FROM="Vahoha <no-reply@vahoha.com>"

# Where contact-form messages are sent.
# Optional. If missing: uses the built-in inbox.
# CONTACT_INBOX=hello@vahoha.com

# ── Image uploads ───────────────────────────────────────────────────────

# Cloudinary cloud name (profile photos, blog images). Set all three Cloudinary variables or none.
# Optional. If missing: image uploads fail.
# CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key.
# Optional. If missing: image uploads fail.
# CLOUDINARY_API_KEY=your-cloudinary-key

# Cloudinary API secret.
# Optional. If missing: image uploads fail.
# CLOUDINARY_API_SECRET=your-cloudinary-secret

# ── Billing (Polar) ─────────────────────────────────────────────────────

# Only the exact value "production" uses the real Polar; anything else is the sandbox, so a forgotten value can never charge a card.
# Optional. If missing: Polar sandbox.
# POLAR_ENVIRONMENT=sandbox

# Polar organisation access token. Required when BILLING_ENFORCED=true.
# Optional. If missing: checkout cannot be created.
# POLAR_ACCESS_TOKEN=polar_oat_your-token

# Id of the Pro product in Polar. Required when BILLING_ENFORCED=true.
# Optional. If missing: checkout cannot be created.
# POLAR_PRO_PRODUCT_ID=your-polar-product-id

# Signs Polar webhooks. Required when BILLING_ENFORCED=true.
# Optional. If missing: the webhook answers 503 on purpose.
# POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# true makes Pro gates real. Anything else keeps every feature free (the pilot setting).
# Optional. If missing: everything is free.
# BILLING_ENFORCED=false

# ── Redis ───────────────────────────────────────────────────────────────

# false runs without Redis: no notification queue and no Redis login throttling. Any other value (or unset) means on.
# Optional. If missing: Redis is on.
# REDIS_ENABLED=true

# Hosted Redis URL with host, port, password and TLS. Wins over the host/port variables.
# Optional. If missing: uses REDIS_HOST and REDIS_PORT, or localhost.
# REDIS_URL=rediss://default:password@host:6379

# Redis host for a local or Docker Redis (ignored when REDIS_URL is set).
# Optional. If missing: localhost.
# REDIS_HOST=localhost

# Redis port (ignored when REDIS_URL is set).
# Optional. If missing: 6379.
# REDIS_PORT=6379

# Redis password (ignored when REDIS_URL is set).
# Optional. If missing: no password.
# REDIS_PASSWORD=your-redis-password

# ── Switches ────────────────────────────────────────────────────────────

# true opens the recruiter candidates list API. Leave it off until the page is switched on.
# Optional. If missing: the candidates API stays closed.
# CANDIDATES_ENABLED=false

# true makes every route answer 503 (/healthz stays up). The emergency stop.
# Optional. If missing: normal service.
# MAINTENANCE_MODE=false

# false turns the server-side cache off (to rule it out while debugging). Unset means on, except under tests.
# Optional. If missing: cache on.
# CACHE_ENABLED=true

# true lets the code runner execute learner code outside the isolated-vm sandbox when it did not build. NEVER in production.
# Optional. If missing: in production the runner refuses submissions when isolated-vm is missing.
# ALLOW_UNSAFE_RUNNER=false

# Extra browser origins allowed to open a WebSocket, comma separated (besides FRONTEND_URL).
# Optional. If missing: only FRONTEND_URL may connect.
# WS_EXTRA_ORIGINS=https://staging.vahoha.com

# ── Local and scripts only ──────────────────────────────────────────────

# Local-only workaround for the Groq free tier's tokens-per-minute limit. Do NOT set it in production.
# Optional. If missing: no limit applied.
# GROQ_TPM_LIMIT=6000

# Model used by the mentor eval script only.
# Optional. If missing: uses the built-in model.
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# Comma-separated DNS servers, for networks that cannot resolve Atlas's mongodb+srv records.
# Optional. If missing: uses the system DNS.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Seed scripts only: 1 lets the capstone seeder publish briefs whose exam banks are missing.
# Optional. If missing: the seeder skips unbanked tracks.
# ALLOW_UNBANKED_PUBLISH=0

# ── Frontend (Vite) ────────────────────────────────────────────────────

# Backend API base URL, no trailing slash.
# VITE_API_BASE_URL=http://localhost:5000

# Backend WebSocket URL.
# VITE_WS_URL=ws://localhost:5000

# Same Google OAuth client id as GOOGLE_CLIENT_ID. Public by design.
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# PostHog project key. Analytics stay off without it.
# VITE_POSTHOG_KEY=phc_your-posthog-key

# PostHog host.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
